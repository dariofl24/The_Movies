<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Movie Catalog</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="top">
  <a href="/" class="brand">🎬 Movie Catalog</a>
  <form class="filters" method="get" action="/">
    <input type="search" name="q" value="<%= q %>" placeholder="Search by title…" aria-label="Search by title">
    <select name="genre" aria-label="Genre">
      <option value="">All genres</option>
      <% genres.forEach(g => { %><option value="<%= g %>" <%= g === genre ? 'selected' : '' %>><%= g %></option><% }) %>
    </select>
    <button type="submit">Search</button>
  </form>
</header>
<main>
